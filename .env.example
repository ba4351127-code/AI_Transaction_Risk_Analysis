# ==============================================================================
# TransactionGuard AI - Environment Configuration Guide
# ==============================================================================
# For Local Development:
# Copy this file to .env or leave unset (all variables have safe local defaults).
# Your local SQLite database (transactionguard.db) is used automatically.
#
# For Vercel Production Deployment:
# Enter these key-value pairs in: Vercel Dashboard -> Settings -> Environment Variables.
# ==============================================================================

# Core Project Configuration
PROJECT_NAME="TransactionGuard AI"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Environment Mode: Set to 'production' on Vercel, 'development' on local PC
ENV="production"
DEBUG=false

# Security & Authentication (JWT HS256)
# Generate a secure 64-character token for production using:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY="replace_with_a_secure_random_64_character_hex_key_for_production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration:
# ------------------------------------------------------------------------------
# LOCAL PC (Default):
# Leave DATABASE_URL commented out or unset to use your local SQLite database:
# DATABASE_URL="sqlite+aiosqlite:///backend/transactionguard.db"
#
# VERCEL PRODUCTION (Neon Serverless PostgreSQL):
# 1. Create a free database at https://neon.tech
# 2. Copy the connection string from your Neon dashboard
# 3. Paste it here (both postgres:// and postgresql:// are automatically handled):
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# CORS Configuration
# On Vercel, frontend and backend share the SAME origin (no CORS needed).
# If querying from external domains, list them here:
BACKEND_CORS_ORIGINS='["*"]'
